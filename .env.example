DB_NAME=bms
DB_USER=bms
DB_PASSWORD=local-bms-password
BMS_SECRET_KEY=local-development-placeholder
BMS_ALLOWED_HOSTS=localhost,127.0.0.1
BMS_CSRF_TRUSTED_ORIGINS=
# Optional separate HTTPS hostname for the participant test.
BMS_RIDE_PORTAL_HOST=
BMS_HTTPS=0
BMS_DEBUG=0

# Optional server-owned configuration. Leave disabled to set up IMAP in the app.
BMS_IMAP_ENABLED=0
BMS_IMAP_HOST=
BMS_IMAP_PORT=993
BMS_IMAP_USERNAME=
BMS_IMAP_PASSWORD=
BMS_IMAP_MAILBOX=INBOX
